{
  "name": "tirelo-payment-service",
  "version": "1.0.0",
  "description": "Payment system module for the Tirelo Services application. Supports Orange Money, Mascom MyZaka and bank transfers with a pluggable gateway architecture.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "test:pg": "jest --config jest.pg.config.js --runInBand",
    "motse:start": "node motse/src/server.js",
    "motse:test": "jest --config motse/jest.config.js --runInBand",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --config=playwright.ui.config.ts",
    "test:e2e:server": "node src/test-server.js",
    "docs:api": "node scripts/generate-api-docs.js",
    "bench": "node benchmark/scripts/run-all.js",
    "bench:small": "node benchmark/scripts/run-all.js small",
    "bench:seed": "node benchmark/scripts/seed.js",
    "bench:queries": "node benchmark/scripts/analyze-queries.js"
  },
  "keywords": [
    "tirelo",
    "payments",
    "orange-money",
    "myzaka",
    "mascom",
    "express",
    "mongodb"
  ],
  "author": "Tirelo Services",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.22.0",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.1"
  },
  "optionalDependencies": {
    "firebase-admin": "^12.1.0",
    "ioredis": "^5.4.1",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.3",
    "supertest": "^7.0.0"
  }
}
