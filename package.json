{
  "name": "tirelo-payment-service",
  "version": "1.0.0",
  "description": "Payment system module for the Tirelo Services application. Supports Orange Money, Mascom MyZaka and bank transfers with a pluggable gateway architecture.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "test:pg": "jest --config jest.pg.config.js --runInBand",
    "motse:start": "node motse/src/server.js",
    "motse:test": "jest --config motse/jest.config.js --runInBand",
    "typecheck": "node -e \"require('./motse/src/container').createPlatform(); console.log('module graph loads')\"",
    "test:persistence": "jest --config motse/jest.config.js --runInBand tests/persistence.test.js",
    "test:outbox": "jest --config motse/jest.config.js --runInBand tests/outbox.test.js",
    "test:redis": "jest --config motse/jest.config.js --runInBand tests/distributed.test.js",
    "motse:coverage:foundation": "jest --config motse/jest.config.js --runInBand --coverage --collectCoverageFrom='src/persistence/**' --collectCoverageFrom='src/distributed/**' --collectCoverageFrom='src/kernel/store.js' --coverageThreshold='{\"global\":{\"statements\":95,\"lines\":95,\"branches\":90}}' --rootDir=motse",
    "motse:coverage": "jest --config motse/jest.config.js --runInBand --coverage --collectCoverageFrom='src/pilot/**' --collectCoverageFrom='src/analytics/**' --collectCoverageFrom='src/ops/**' --collectCoverageFrom='src/integrations/**' --collectCoverageFrom='src/ai/providers/**' --collectCoverageFrom='src/security/assurance.service.js' --coverageThreshold='{\"global\":{\"statements\":95,\"lines\":95,\"branches\":90}}' --rootDir=motse",
    "motse:coverage:p3": "jest --config motse/jest.config.js --runInBand --coverage --collectCoverageFrom='src/payments/paypal.provider.js' --collectCoverageFrom='src/workflow/**' --collectCoverageFrom='src/plugins/*.js' --collectCoverageFrom='src/developer/**' --collectCoverageFrom='src/ai/evaluation/**' --collectCoverageFrom='src/security/scorecard.js' --collectCoverageFrom='src/i18n/**' --coverageThreshold='{\"global\":{\"statements\":95,\"lines\":95,\"branches\":90}}' --rootDir=motse",
    "motse:coverage:p4": "jest --config motse/jest.config.js --runInBand --coverage --collectCoverageFrom='src/payments/card.provider.js' --collectCoverageFrom='src/payments/card.service.js' --collectCoverageFrom='src/payments/gateways/**' --coverageThreshold='{\"global\":{\"statements\":95,\"lines\":95,\"branches\":90}}' --rootDir=motse",
    "motse:coverage:p5": "jest --config motse/jest.config.js --runInBand --coverage --collectCoverageFrom='src/events/**' --collectCoverageFrom='src/qr/**' --coverageThreshold='{\"global\":{\"statements\":95,\"lines\":95,\"branches\":90}}' --rootDir=motse",
    "motse:coverage:p6": "jest --config motse/jest.config.js --runInBand --coverage --collectCoverageFrom='src/governance/**' --coverageThreshold='{\"global\":{\"statements\":95,\"lines\":95,\"branches\":90}}' --rootDir=motse",
    "motse:coverage:observability": "jest --config motse/jest.config.js --runInBand --coverage --collectCoverageFrom='src/observability/**' --coverageThreshold='{\"global\":{\"statements\":95,\"lines\":95,\"branches\":90}}' --rootDir=motse",
    "motse:coverage:enterprise": "jest --config motse/jest.config.js --runInBand --coverage --collectCoverageFrom='src/security/adaptive.rateLimiter.js' --collectCoverageFrom='src/observability/dependency.health.js' --coverageThreshold='{\"global\":{\"statements\":95,\"lines\":95,\"branches\":90}}' --rootDir=motse",
    "motse:coverage:resilience": "jest --config motse/jest.config.js --runInBand --coverage --collectCoverageFrom='src/resilience/**' --collectCoverageFrom='src/observability/runtime.intelligence.js' --coverageThreshold='{\"global\":{\"statements\":95,\"lines\":95,\"branches\":90}}' --rootDir=motse",
    "motse:coverage:config": "jest --config motse/jest.config.js --runInBand --coverage --collectCoverageFrom='src/config/**' --collectCoverageFrom='src/observability/capacity.planner.js' --coverageThreshold='{\"global\":{\"statements\":95,\"lines\":95,\"branches\":90}}' --rootDir=motse",
    "motse:coverage:govdr": "jest --config motse/jest.config.js --runInBand --coverage --collectCoverageFrom='src/config/config.governance.js' --collectCoverageFrom='src/ops/dr.validator.js' --coverageThreshold='{\"global\":{\"statements\":95,\"lines\":95,\"branches\":90}}' --rootDir=motse",
    "motse:coverage:business": "jest --config motse/jest.config.js --runInBand --coverage --collectCoverageFrom='src/observability/business.observability.js' --collectCoverageFrom='src/observability/operational.intelligence.js' --coverageThreshold='{\"global\":{\"statements\":95,\"lines\":95,\"branches\":90}}' --rootDir=motse",
    "motse:coverage:analytics": "jest --config motse/jest.config.js --runInBand --coverage --collectCoverageFrom='src/observability/governance.analytics.js' --collectCoverageFrom='src/observability/forecast.accuracy.js' --coverageThreshold='{\"global\":{\"statements\":95,\"lines\":95,\"branches\":90}}' --rootDir=motse",
    "motse:coverage:reconciliation": "jest --config motse/jest.config.js --runInBand --coverage --collectCoverageFrom='src/observability/business.reconciliation.js' --collectCoverageFrom='src/observability/recommendation.effectiveness.js' --coverageThreshold='{\"global\":{\"statements\":95,\"lines\":95,\"branches\":90}}' --rootDir=motse",
    "motse:coverage:executive": "jest --config motse/jest.config.js --runInBand --coverage --collectCoverageFrom='src/observability/executive.intelligence.js' --coverageThreshold='{\"global\":{\"statements\":95,\"lines\":95,\"branches\":90}}' --rootDir=motse",
    "motse:validate": "node motse/scripts/production-validation.js",
    "motse:validate:smoke": "node motse/scripts/production-validation.js --smoke",
    "motse:slo": "node deploy/motse/observability/generate-slo-assets.js",
    "motse:bench": "node motse/scripts/benchmark.js",
    "motse:load": "node motse/scripts/load-test.js",
    "motse:resilience": "node motse/scripts/resilience-test.js",
    "motse:security-scan": "node motse/scripts/security-scan.js",
    "motse:secret-scan": "node motse/scripts/secret-scan.js",
    "motse:ai-eval": "node motse/scripts/ai-eval.js",
    "motse:openapi": "node motse/scripts/generate-openapi.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --config=playwright.ui.config.ts",
    "test:e2e:server": "node src/test-server.js",
    "docs:api": "node scripts/generate-api-docs.js",
    "bench": "node benchmark/scripts/run-all.js",
    "bench:small": "node benchmark/scripts/run-all.js small",
    "bench:seed": "node benchmark/scripts/seed.js",
    "bench:queries": "node benchmark/scripts/analyze-queries.js"
  },
  "keywords": [
    "tirelo",
    "payments",
    "orange-money",
    "myzaka",
    "mascom",
    "express",
    "mongodb"
  ],
  "author": "Tirelo Services",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.22.0",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.1"
  },
  "optionalDependencies": {
    "firebase-admin": "^12.1.0",
    "ioredis": "^5.4.1",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.3",
    "supertest": "^7.0.0"
  }
}
