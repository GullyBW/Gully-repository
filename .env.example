# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- Database ----
# Driver: 'postgres' (default) or 'mongo'.
DB_DRIVER=postgres
# PostgreSQL (default driver):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tirelo
# MongoDB (only used when DB_DRIVER=mongo):
MONGODB_URI=mongodb://localhost:27017/tirelo

# ---- Payment defaults ----
# ISO 4217 currency code. Botswana Pula by default.
DEFAULT_CURRENCY=BWP

# ---- Authentication ----
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=10

# ---- Email (verification / password reset) ----
EMAIL_TRANSPORT=console
EMAIL_FROM=Tirelo Services <no-reply@tirelo.example.com>
APP_BASE_URL=http://localhost:8100

# ---- Redis / cache (optional: omit for in-process cache) ----
REDIS_URL=
CACHE_TTL_SECONDS=60

# ---- Push notifications (FCM; optional: console fallback) ----
PUSH_TRANSPORT=console
FCM_SERVICE_ACCOUNT=
PUSH_MAX_RETRIES=3

# ---- Image storage ----
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_PUBLIC_BASE_URL=

# ---- Realtime ----
CORS_ORIGIN=*

# ---- Google Maps (optional: omit to use the built-in Botswana sandbox) ----
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com/maps/api

# ---- Security / limits ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880

# Public base URL used to build webhook/callback URLs sent to providers.
PUBLIC_BASE_URL=http://localhost:4000

# ---- Orange Money ----
ORANGE_MONEY_BASE_URL=https://api.orange.com/orange-money-webpay/bw/v1
ORANGE_MONEY_MERCHANT_ID=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_WEBHOOK_SECRET=changeme

# ---- Mascom MyZaka ----
MYZAKA_BASE_URL=https://api.mascom.bw/myzaka/v1
MYZAKA_MERCHANT_ID=
MYZAKA_API_KEY=
MYZAKA_WEBHOOK_SECRET=changeme

# ---- Bank transfer ----
BANK_NAME=First National Bank Botswana
BANK_ACCOUNT_NAME=Tirelo Services (Pty) Ltd
BANK_ACCOUNT_NUMBER=00000000000
BANK_BRANCH_CODE=000000

# ---- Card gateway (Visa/Mastercard hosted checkout: DPO / Flutterwave / Stripe) ----
CARD_GATEWAY_BASE_URL=
CARD_GATEWAY_PUBLIC_KEY=
CARD_GATEWAY_SECRET_KEY=
CARD_GATEWAY_WEBHOOK_SECRET=changeme
CARD_GATEWAY_RETURN_URL=http://localhost:4000/payment/complete

# ======================================================================
#  Day-trading subsystem (see docs/TRADING.md)
#  Everything below defaults to a SAFE, OFFLINE paper-trading sandbox.
# ======================================================================

# Market-data source: 'simulated' (default, offline) or 'ibkr'.
TRADING_DATA_PROVIDER=simulated

# Execution safety — BOTH must be set before a real order can ever be routed.
TRADING_RUN_MODE=paper            # 'paper' (simulated fills) or 'live'
TRADING_LIVE_ORDERS_ENABLED=false # second, independent live switch

TRADING_BASE_CURRENCY=USD
TRADING_WATCHLIST=AAPL,MSFT,NVDA,TSLA,AMZN,SPY

# ---- Interactive Brokers Client Portal Gateway ----
# Run the gateway locally (java -jar), authenticate once in the browser, then:
IBKR_GATEWAY_URL=https://localhost:5000/v1/api
IBKR_ACCOUNT_ID=
IBKR_TLS_REJECT_UNAUTHORIZED=false  # gateway uses a self-signed localhost cert
IBKR_TIMEOUT_MS=8000

# ---- Risk limits (applied to every position-sizing decision) ----
TRADING_STARTING_EQUITY=100000
TRADING_RISK_PER_TRADE_PCT=0.01     # risk at most 1% of equity to the stop
TRADING_MAX_POSITION_PCT=0.2        # 20% notional cap per position
TRADING_MAX_EXPOSURE_PCT=1.0        # gross exposure cap across the book
TRADING_MAX_OPEN_POSITIONS=8
TRADING_MAX_DAILY_LOSS_PCT=0.03     # daily-loss kill switch (3%)
TRADING_TARGET_VOL_PCT=0.15         # annualised volatility target
TRADING_KELLY_FRACTION=0.5          # half-Kelly overlay
TRADING_ATR_STOP_MULT=2.0
TRADING_ATR_TARGET_MULT=3.0

# ---- Ensemble strategy weights ----
TRADING_W_MOMENTUM=1.0
TRADING_W_MEANREV=0.8
TRADING_W_BREAKOUT=1.0
TRADING_W_NEWS=1.2
