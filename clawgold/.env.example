# ClawGold Environment Variables
# Copy this file to .env and fill in your credentials

# MT5 Credentials (required only when TRADING_MODE=real)
# Live trading additionally needs a real MT5_LOGIN — the broker factory
# refuses to start in real mode without one.
MT5_LOGIN=your_login_here
MT5_PASSWORD=your_password_here
MT5_SERVER=your_server_here
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Trading Settings
# simulation = paper broker, no real orders (default, and what CI uses)
# real       = live MetaTrader 5 execution with real money
TRADING_MODE=simulation
RISK_PER_TRADE=0.01
# Default stop distance in price units (USD/oz for gold), used for sizing
DEFAULT_STOP_DISTANCE=5.0

# Alert Settings (optional)
PROFIT_ALERT_THRESHOLD=100
LOSS_ALERT_THRESHOLD=50

# Docker Worker Settings (optional)
RESEARCH_SYMBOL=XAUUSD
RESEARCH_INTERVAL_SECONDS=1800
RESEARCH_USE_AI=true
# RESEARCH_QUERY=Fed interest rate impact on gold

# Telegram Notifications (optional)
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Signal service channels — your own Telegram channel IDs, one per tier
SIGNAL_CH_FREE=
SIGNAL_CH_BASIC=
SIGNAL_CH_PRO=
SIGNAL_CH_VIP=
