# Reverse proxy for the Tirelo Services API (TLS termination + WebSocket upgrade).
# Place behind certbot-managed certificates; adjust server_name / upstream.

upstream tirelo_api {
  server 127.0.0.1:4000;
  keepalive 32;
}

server {
  listen 80;
  server_name api.tirelo.example.com;
  # Redirect everything to HTTPS.
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name api.tirelo.example.com;

  ssl_certificate     /etc/letsencrypt/live/api.tirelo.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/api.tirelo.example.com/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;

  client_max_body_size 6m;            # matches upload limit headroom

  location / {
    proxy_pass http://tirelo_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # WebSocket upgrade for Socket.IO
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 300s;
  }
}
