{
  "uid": "motse-config",
  "title": "Motse · Configuration Platform",
  "schemaVersion": 39,
  "tags": [
    "motse",
    "config"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Config changes by op (rps)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (op) (rate(motse_config_changes_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Total config changes (1h)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(motse_config_changes_total[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Kill switch active (1=on)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "motse_config_kill_switch",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Safe mode active (1=on)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "motse_config_safe_mode",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Governance actions by risk (1h)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (risk, event) (increase(motse_config_governance_total[1h]))",
          "refId": "A"
        }
      ]
    }
  ]
}
