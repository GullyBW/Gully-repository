{
  "uid": "motse-governance",
  "title": "Motse · Governance Analytics",
  "schemaVersion": 39,
  "tags": [
    "motse",
    "governance"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Compliance score (0..1)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "motse_governance_compliance_score",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Operational maturity score (0..1)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "motse_governance_maturity_score",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Rollback rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "motse_governance_rollback_rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Governance actions by event (1h)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (event) (increase(motse_config_governance_total[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Emergency activations (1h)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (type) (increase(motse_config_emergency_total[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Forecast accuracy (0..1)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "motse_forecast_accuracy",
          "refId": "A"
        }
      ]
    }
  ]
}
