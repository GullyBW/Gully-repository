{
  "uid": "motse-payments",
  "title": "Motse · Payments",
  "schemaVersion": 39,
  "tags": [
    "motse",
    "payments"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Payments by outcome",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(motse_payments_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Success rate (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "100 * sum(rate(motse_payments_total{outcome=\"completed\"}[5m])) / clamp_min(sum(rate(motse_payments_total[5m])), 1e-9)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Webhook rejections by reason",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(motse_webhooks_rejected_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Retry queue depth",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "motse_payment_retry_queue_depth",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Dead letters",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "motse_payment_dead_letters",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Per-provider volume",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (provider) (rate(motse_payments_total[5m]))",
          "refId": "A"
        }
      ]
    }
  ]
}
