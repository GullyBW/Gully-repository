{
  "uid": "motse-offline-sync",
  "title": "Motse · Offline Sync",
  "schemaVersion": 39,
  "tags": [
    "motse",
    "offline-sync"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Outbox mutations applied",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "motse_outbox_mutations_applied",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Sync batches (rps)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(motse_http_requests_total{route=\"/v1/sync/outbox\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Sync failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(motse_http_requests_total{route=\"/v1/sync/outbox\",code=~\"4..|5..\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "USSD/SMS letsema joins",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(motse_domain_events_total{type=\"kgotla.letsema.joined\"}[5m]))",
          "refId": "A"
        }
      ]
    }
  ]
}
