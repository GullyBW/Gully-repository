{
  "uid": "motse-ratelimit",
  "title": "Motse · Adaptive Rate Limiting",
  "schemaVersion": 39,
  "tags": [
    "motse",
    "ratelimit"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Decisions by class (rps)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (class) (rate(motse_ratelimit_adaptive_total{result=\"allowed\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Rejections by class (rps)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (class) (rate(motse_ratelimit_adaptive_total{result=~\"limited|banned\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Rejection ratio by class (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "100 * sum by (class) (rate(motse_ratelimit_adaptive_total{result=~\"limited|banned\"}[5m])) / clamp_min(sum by (class) (rate(motse_ratelimit_adaptive_total[5m])), 1e-9)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Ban decisions (rps)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(motse_ratelimit_adaptive_total{result=\"banned\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Saturation trend (limited, 1h window)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (class) (increase(motse_ratelimit_adaptive_total{result=\"limited\"}[1h]))",
          "refId": "A"
        }
      ]
    }
  ]
}
