{
  "uid": "motse-business",
  "title": "Motse · Business Observability",
  "schemaVersion": 39,
  "tags": [
    "motse",
    "business"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Business events by capability/outcome (rps)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (capability, outcome) (rate(motse_business_events_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "SLA compliance by capability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "motse_business_sla",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Value processed by capability (minor)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "motse_business_value_minor",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Failed business events (1h)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (capability) (increase(motse_business_events_total{outcome=\"failure\"}[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Success rate by capability (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "100 * sum by (capability) (rate(motse_business_events_total{outcome=\"success\"}[5m])) / clamp_min(sum by (capability) (rate(motse_business_events_total[5m])), 1e-9)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Open operational recommendations",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "motse_opsintel_recommendations",
          "refId": "A"
        }
      ]
    }
  ]
}
