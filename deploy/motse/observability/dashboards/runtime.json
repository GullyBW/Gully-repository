{
  "uid": "motse-runtime",
  "title": "Motse · Runtime Intelligence (Node)",
  "schemaVersion": 39,
  "tags": [
    "motse",
    "runtime"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Heap used vs limit (bytes)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "motse_runtime_heap_used_bytes",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Heap utilization",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "motse_runtime_heap_utilization",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "RSS (bytes)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "motse_runtime_rss_bytes",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Event-loop utilization",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "motse_runtime_event_loop_utilization",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Event-loop delay p99 (ms)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "motse_runtime_event_loop_delay_p99_ms",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "GC pause p95 (ms)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(motse_runtime_gc_pause_ms_bucket[5m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Active handles",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "motse_runtime_active_handles",
          "refId": "A"
        }
      ]
    }
  ]
}
