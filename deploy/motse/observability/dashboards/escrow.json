{
  "uid": "motse-escrow",
  "title": "Motse · Escrow",
  "schemaVersion": 39,
  "tags": [
    "motse",
    "escrow"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Frozen escrows",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "motse_escrows_frozen",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Stuck escrows (30d+)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "motse_escrows_stuck",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Milestones released (rps)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(motse_domain_events_total{type=\"kgetsi.milestone.released\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Contributions (rps)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(motse_domain_events_total{type=\"kgetsi.contribution.received\"}[5m]))",
          "refId": "A"
        }
      ]
    }
  ]
}
