{
  "uid": "motse-dr",
  "title": "Motse · Disaster Recovery",
  "schemaVersion": 39,
  "tags": [
    "motse",
    "dr"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "DR runs by scenario/result (rate)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (scenario, result) (rate(motse_dr_runs_total[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Recovery confidence (0..1)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "motse_dr_recovery_confidence",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "RTO max across scenarios (ms)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "motse_dr_rto_max_ms",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Recovery duration p95 (ms)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(motse_dr_recovery_ms_bucket[5m])) by (le))",
          "refId": "A"
        }
      ]
    }
  ]
}
