  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "title": "availability — current",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "1 - (sum(rate(motse_http_requests_total{code=~\"5..\"}[5m]))\n  / clamp_min(sum(rate(motse_http_requests_total[5m])), 1e-9))",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.999
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "availability — trend (objective >= 0.999, window 30d)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "1 - (sum(rate(motse_http_requests_total{code=~\"5..\"}[5m]))\n  / clamp_min(sum(rate(motse_http_requests_total[5m])), 1e-9))",
          "refId": "A"
        }
      ],
      "description": "0 responses >=500 in 8,543 requests under 24-worker sustained load including fault-injection phases (validation W1); 99.9% leaves a 43m/30d error budget for real-world dependency failure."
    },
